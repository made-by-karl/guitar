    "arrangement": [
      {
        "id": "open-road-occurrence-intro",
        "partId": "open-road-intro",
        "lyrics": ""
      },
      {
        "id": "open-road-occurrence-verse-1",
        "partId": "open-road-verse",
        "lyrics": "Old guitar and a worn-out case,\nMorning wind upon my face.\nOne more mile beyond the tracks,\nNothing here is holding us back."
      },
      {
        "id": "open-road-occurrence-chorus-1",
        "partId": "open-road-chorus",
        "lyrics": "Take the open road tonight,\nTurn the dark into a light.\nSide by side, we sing out loud,\nFour small chords can shake this town."
      },
      {
        "id": "open-road-occurrence-verse-2",
        "partId": "open-road-verse",
        "lyrics": "Streetlights fade behind the hill,\nWe keep moving, singing still.\nEvery turn becomes a song,\nFind the beat and come along."
      },
      {
        "id": "open-road-occurrence-chorus-2",
        "partId": "open-road-chorus",
        "lyrics": "Take the open road tonight,\nTurn the dark into a light.\nSide by side, we sing out loud,\nFour small chords can shake this town."
      },
      {
        "id": "open-road-occurrence-outro",
        "partId": "open-road-outro",
        "lyrics": "Let it ring, then let it go."
      }
    ],
